 "layers": [
  {
   "id": "nisar_class",
   "group": "NISAR radar (2026)",
   "default": true,
   "title": "Flood classes from NISAR",
   "kind": "image",
   "times": [
    "2026-06-26",
    "2026-07-08",
    "2026-07-20",
    "2026-08-13",
    "2026-08-25",
    "2026-09-06",
    "2026-09-18",
    "2026-09-30",
    "2026-10-12",
    "2026-10-24"
   ],
   "url": "{time}/class.webp",
   "bounds": "{time}/bounds.json",
   "opacity": 0.85,
   "legend": [
    {
     "class": "open_water",
     "color": [
      33,
      113,
      181,
      210
     ],
     "label": "Open water",
     "why": "Calm water mirrors the radar pulse away, so very little energy returns: HH is very low."
    },
    {
     "class": "flooded_vegetation",
     "color": [
      49,
      163,
      84,
      200
     ],
     "label": "Flooded vegetation",
     "why": "The pulse bounces off the water and then off trunks and stems and returns to the radar (double bounce): HH is very high and much higher than HV. L-band sees this under the canopy; C-band largely cannot."
    }
   ],
   "source": "nisar",
   "chart": "nisar",
   "note": "Our classification. Blue = open water, green = water under vegetation, which only L-band radar sees."
  },
